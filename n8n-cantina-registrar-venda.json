{
  "name": "Cantina - Registrar Venda",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cantina-registrar-venda",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-cantina",
      "name": "Webhook Cantina",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "cantina-registrar-venda"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "value": "1UMuBbFc_hbdtRRdiVboCbpLLpkkeL0XQuS1gtuXJxIE", "mode": "id" },
        "sheetName": { "__rl": true, "value": "vendas_cantina", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $now.toMillis() }}",
            "data": "={{ $json.body.data }}",
            "hora": "={{ $json.body.hora }}",
            "evento": "={{ $json.body.evento }}",
            "itens": "={{ $json.body.itens }}",
            "total_arrecadado": "={{ $json.body.total_arrecadado }}"
          }
        },
        "options": {}
      },
      "id": "gravar-venda",
      "name": "Gravar Venda",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [480, 300],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "FHehnCnmZ5O9ewQX", "name": "Google Sheets account 2" }
      }
    },
    {
      "parameters": {
        "documentId": { "__rl": true, "value": "1UMuBbFc_hbdtRRdiVboCbpLLpkkeL0XQuS1gtuXJxIE", "mode": "id" },
        "sheetName": { "__rl": true, "value": "estoque_cantina", "mode": "name" },
        "options": {}
      },
      "id": "ler-estoque",
      "name": "Ler Estoque",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [480, 500],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "FHehnCnmZ5O9ewQX", "name": "Google Sheets account 2" }
      }
    },
    {
      "parameters": {
        "jsCode": "const vendidos = $('Webhook Cantina').first().json.body.itens_json || [];\nconst estoque = $('Ler Estoque').all().map(i => i.json);\n\nconst updates = [];\nfor (const v of vendidos) {\n  const row = estoque.find(r => r.id === v.id);\n  if (row) {\n    updates.push({\n      id: v.id,\n      nome: row.nome,\n      quantidade: Math.max(0, Number(row.quantidade) - Number(v.qty))\n    });\n  }\n}\nreturn updates.map(u => ({ json: u }));"
      },
      "id": "calcular-estoque",
      "name": "Calcular Novo Estoque",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 500]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "1UMuBbFc_hbdtRRdiVboCbpLLpkkeL0XQuS1gtuXJxIE", "mode": "id" },
        "sheetName": { "__rl": true, "value": "estoque_cantina", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.id }}",
            "quantidade": "={{ $json.quantidade }}"
          },
          "matchingColumns": ["id"]
        },
        "options": {}
      },
      "id": "atualizar-estoque",
      "name": "Atualizar Estoque",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [960, 500],
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "FHehnCnmZ5O9ewQX", "name": "Google Sheets account 2" }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true }",
        "options": {
          "responseHeaders": {
            "entries": [{ "name": "Access-Control-Allow-Origin", "value": "*" }]
          }
        }
      },
      "id": "respond-ok",
      "name": "Responder OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Webhook Cantina": {
      "main": [
        [
          { "node": "Gravar Venda",   "type": "main", "index": 0 },
          { "node": "Ler Estoque",    "type": "main", "index": 0 }
        ]
      ]
    },
    "Gravar Venda": {
      "main": [[{ "node": "Responder OK", "type": "main", "index": 0 }]]
    },
    "Ler Estoque": {
      "main": [[{ "node": "Calcular Novo Estoque", "type": "main", "index": 0 }]]
    },
    "Calcular Novo Estoque": {
      "main": [[{ "node": "Atualizar Estoque", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": []
}
